{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "rootDirs": [
      "src",
      "build/dev/javascript/glimlit"
    ],
    "allowJs": true
  },
  "include": [
    "src/**/view.mjs",
    "src/**/effects.mjs",
    "src/**/subscriptions.mjs",
    "src/runtime/runner.mjs",
    "src/runtime/render.mjs",
    "src/runtime/server.mjs"
  ]
}
